---
// Floating section dock — the rounded right-side rail from the Saj Innovative
// site. Appears once the hero is behind you and tracks the section in view.
const sections = [
  { id: "top", label: "Home" },
  { id: "features", label: "Why Clean Pro" },
  { id: "services", label: "Services" },
  { id: "how", label: "How it works" },
  { id: "faq", label: "FAQ" },
  { id: "contact", label: "Contact" },
];
---

<nav
  id="section-dock"
  aria-label="Page sections"
  class="pointer-events-none fixed right-3 top-1/2 z-40 hidden -translate-y-1/2 translate-x-6 rounded-full border border-white/70 bg-brand-50/85 px-3.5 py-5 opacity-0 shadow-[0_18px_45px_-25px_rgba(30,33,36,0.5)] backdrop-blur-md transition-all duration-300 xl:block 2xl:right-6"
>
  <ul class="flex flex-col items-end gap-4">
    {
      sections.map((s) => (
        <li class="w-full">
          <a
            href={`#${s.id}`}
            data-section={s.id}
            tabindex="-1"
            class="dock-item group/item flex items-center justify-end gap-3"
          >
            <span class="dock-label whitespace-nowrap text-right text-sm font-medium text-ink-600 transition-colors group-hover/item:text-ink-900">
              {s.label}
            </span>

            {/* Marker — the current section stretches into a bar */}
            <span class="flex h-6 w-2 shrink-0 items-center justify-center">
              <span class="dock-marker h-2 w-2 rounded-full bg-ink-400 transition-all duration-300 group-hover/item:h-3 group-hover/item:bg-ink-600" />
            </span>
          </a>
        </li>
      ))
    }
  </ul>
</nav>

<style>
  #section-dock.is-visible {
    pointer-events: auto;
    opacity: 1;
    transform: translate(0, -50%);
  }
  .dock-item.is-active .dock-label {
    font-weight: 600;
    color: var(--color-brand-600);
  }
  .dock-item.is-active .dock-marker {
    height: 1.5rem;
    background: var(--color-brand-500);
  }
</style>

<script>
  const dock = document.getElementById("section-dock");
  if (dock) {
    const items = Array.from(dock.querySelectorAll<HTMLAnchorElement>(".dock-item"));
    const targets = items
      .map((item) => ({
        item,
        el: document.getElementById(item.dataset.section ?? ""),
      }))
      .filter((t): t is { item: HTMLAnchorElement; el: HTMLElement } => Boolean(t.el));

    const onScroll = () => {
      // Only worth showing once the visitor is past the hero.
      const visible = window.scrollY > window.innerHeight * 0.7;
      dock.classList.toggle("is-visible", visible);
      items.forEach((i) => i.setAttribute("tabindex", visible ? "0" : "-1"));

      // Whichever section has crossed the reading line is the current one.
      const line = window.scrollY + window.innerHeight * 0.3;
      let current = targets[0];
      for (const t of targets) {
        if (t.el.offsetTop <= line) current = t;
      }
      targets.forEach((t) => t.item.classList.toggle("is-active", t === current));
    };

    onScroll();
    window.addEventListener("scroll", onScroll, { passive: true });
  }
</script>
