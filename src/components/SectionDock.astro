---
// Section rail, pinned to the right edge on large screens — a bare column of
// tick marks, no panel. It takes over wayfinding once the hero is behind you:
// the active section's tick stretches, and labels only surface on hover.
//
// Ids must be listed in document order — the active-section measurement below
// walks the list and keeps the last one that has crossed the reading line.
const sections = [
  { id: "top", label: "Home" },
  { id: "features", label: "Why Clean Pro" },
  { id: "how", label: "How it works" },
  { id: "services", label: "Services" },
  { id: "faq", label: "FAQ" },
  { id: "contact", label: "Contact" },
];
---

<nav
  id="section-dock"
  aria-label="Page sections"
  class="section-dock fixed right-5 top-1/2 z-40 hidden -translate-y-1/2 xl:block 2xl:right-7"
>
  <ul class="flex flex-col items-end gap-1.5">
    {
      sections.map((section) => (
        <li>
          <a
            href={`#${section.id}`}
            data-dock-link={section.id}
            tabindex="-1"
            class="dock-item relative flex items-center justify-end py-[5px]"
          >
            {/* Out of flow, so revealing it can't nudge the ticks sideways */}
            <span class="dock-label absolute right-full mr-2.5 whitespace-nowrap text-[12px] font-medium">
              {section.label}
            </span>
            <span class="dock-tick" />
          </a>
        </li>
      ))
    }
  </ul>
</nav>

<script>
  const dock = document.getElementById("section-dock");
  if (dock) {
    const links = Array.from(
      dock.querySelectorAll<HTMLAnchorElement>("[data-dock-link]"),
    );
    const nodes = links
      .map((link) => document.getElementById(link.dataset.dockLink!))
      .filter((node): node is HTMLElement => Boolean(node));

    // Panels with a near-black backdrop, marked with `data-dock-dark`. The rail
    // floats free of any plate, so it has to invert over these or it disappears
    // into them. The CTA banner has no tick of its own but still passes under
    // the rail.
    const darkZones = Array.from(
      document.querySelectorAll<HTMLElement>("[data-dock-dark]"),
    );

    let active = "";
    let onDark = false;

    const sync = () => {
      if (!nodes.length) return;

      // Which section the reader is on, measured against a line 40% down the
      // viewport: the last one whose top has crossed it. A thin
      // IntersectionObserver band only reports on crossings, so it can leave
      // the highlight stranded on a section that has long since scrolled away
      // — measuring outright gives the right answer at any offset.
      const doc = document.documentElement;
      let current: string;

      // The footer fills the last screenful, so the final section would never
      // reach the reading line on its own.
      if (window.scrollY + window.innerHeight >= doc.scrollHeight - 4) {
        current = nodes[nodes.length - 1].id;
      } else {
        const line = window.scrollY + window.innerHeight * 0.4;
        current = nodes[0].id;
        for (const node of nodes) {
          if (node.getBoundingClientRect().top + window.scrollY <= line) {
            current = node.id;
          }
        }
      }

      if (current !== active) {
        active = current;
        for (const link of links) {
          const isActive = link.dataset.dockLink === active;
          link.classList.toggle("is-active", isActive);
          if (isActive) link.setAttribute("aria-current", "true");
          else link.removeAttribute("aria-current");
        }
      }

      // Whatever the rail itself is sitting on, which is not always the active
      // section — the CTA banner passes behind it while FAQ is still the one
      // being read. Reaching the middle vertically is not enough: a dark card
      // in the left column never passes under the rail, so the panel has to run
      // out to the right edge as well.
      const middle = window.innerHeight / 2;
      const edge = window.innerWidth - 80;
      const dark = darkZones.some((node) => {
        const rect = node.getBoundingClientRect();
        return rect.top < middle && rect.bottom > middle && rect.right >= edge;
      });
      if (dark !== onDark) {
        onDark = dark;
        dock.classList.toggle("is-on-dark", dark);
      }
    };

    sync();
    window.addEventListener("scroll", sync, { passive: true });
    window.addEventListener("resize", sync);

    // On duty only once the hero is fully out of view.
    const hero = document.getElementById("top");
    const setOnDuty = (onDuty: boolean) => {
      dock.classList.toggle("is-visible", onDuty);
      for (const link of links) link.tabIndex = onDuty ? 0 : -1;
    };

    if (hero) {
      new IntersectionObserver(([entry]) => setOnDuty(!entry.isIntersecting), {
        threshold: 0,
      }).observe(hero);
    }
  }
</script>

<style>
  /* Parked off to the right while off duty, so the handover reads as the rail
     sliding in from the edge rather than blinking into place. */
  .section-dock {
    --tick: rgba(30, 33, 36, 0.25);
    --tick-hover: rgba(30, 33, 36, 0.45);
    --tick-active: var(--color-brand-500);
    --label: rgba(58, 63, 68, 0.85);

    opacity: 0;
    transform: translate(1.25rem, -50%);
    pointer-events: none;
    transition:
      opacity 300ms cubic-bezier(0.22, 1, 0.36, 1),
      transform 300ms cubic-bezier(0.22, 1, 0.36, 1);
  }

  /* No panel to sit on, so the rail inverts over the near-black sections
     instead of vanishing into them. */
  .section-dock.is-on-dark {
    --tick: rgba(255, 255, 255, 0.28);
    --tick-hover: rgba(255, 255, 255, 0.6);
    --tick-active: #ffffff;
    --label: rgba(255, 255, 255, 0.85);
  }

  .section-dock.is-visible {
    opacity: 1;
    transform: translate(0, -50%);
    pointer-events: auto;
  }

  .dock-tick {
    display: block;
    height: 2px;
    width: 14px;
    border-radius: 999px;
    background: var(--tick);
    transition:
      width 250ms cubic-bezier(0.22, 1, 0.36, 1),
      background-color 200ms linear;
  }

  .dock-item:hover .dock-tick {
    width: 20px;
    background: var(--tick-hover);
  }

  .dock-item.is-active .dock-tick,
  .dock-item.is-active:hover .dock-tick {
    width: 24px;
    background: var(--tick-active);
  }

  /* Labels stay out of the way until you reach for one. */
  .dock-label {
    color: var(--label);
    opacity: 0;
    transform: translateX(4px);
    pointer-events: none;
    transition:
      opacity 180ms ease,
      transform 180ms cubic-bezier(0.22, 1, 0.36, 1);
  }

  .dock-item:hover .dock-label,
  .dock-item:focus-visible .dock-label {
    opacity: 1;
    transform: none;
  }

  .dock-item:focus-visible {
    outline: none;
  }

  @media (prefers-reduced-motion: reduce) {
    .section-dock {
      transition: opacity 300ms linear;
      transform: translate(0, -50%);
    }
  }
</style>
