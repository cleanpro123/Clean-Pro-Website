---
// "Why choose Clean Pro" — a bento of four feature cards with inline icons.
import SectionLabel from "./SectionLabel.astro";

const features = [
  {
    title: "Free pickup & delivery",
    body: "We collect your laundry and bring it back clean at a time that suits you — collection and delivery are always free.",
    icon: "truck",
    span: "sm:col-span-3",
  },
  {
    title: "24-hour turnaround",
    body: "Everyday laundry back at your door the next day.",
    icon: "clock",
    span: "sm:col-span-2",
  },
  {
    title: "Gentle, eco-friendly cleaning",
    body: "Plant-based detergents that are kind to your clothes and the planet.",
    icon: "leaf",
    span: "sm:col-span-2",
  },
  {
    title: "Handled by real specialists",
    body: "Every item is sorted, inspected and hand-finished by trained cleaners — never a machine on autopilot.",
    icon: "sparkle",
    span: "sm:col-span-3",
  },
];

const icons = {
  truck:
    '<path d="M3 6h11v9H3zM14 9h4l3 3v3h-7z" /><circle cx="7" cy="18" r="1.6" /><circle cx="17" cy="18" r="1.6" />',
  clock: '<circle cx="12" cy="12" r="8.5" /><path d="M12 7v5l3.5 2" />',
  leaf: '<path d="M5 19c0-8 6-13 15-14-1 9-6 14-14 14" /><path d="M5 19c3-4 7-6 10-7" />',
  sparkle:
    '<path d="M12 3l2 5.5L19.5 10 14 12l-2 5.5L10 12 4.5 10 10 8.5z" /><path d="M18 15.5l.8 2 2 .8-2 .8-.8 2-.8-2-2-.8 2-.8z" />',
};
---

<section id="features" class="bg-lav-50/60 py-14 sm:py-20">
  <div class="reveal mb-8 text-center">
    <SectionLabel>Why Clean Pro</SectionLabel>
    <h2 class="mt-4 font-geist text-2xl font-medium text-ink sm:text-[1.9rem]">
      Laundry, without the laundry day
    </h2>
  </div>

  <div class="mx-auto max-w-6xl px-6">
    <div class="reveal mx-auto grid max-w-[860px] gap-4 sm:grid-cols-5 sm:gap-[18px]">
      {
        features.map((f) => (
          <article class={`flex min-h-[190px] flex-col justify-between rounded-2xl border border-[#e2e2f0] bg-white p-6 ${f.span}`}>
            <span class="grid size-11 place-items-center rounded-xl bg-accent/10 text-accent">
              <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" set:html={icons[f.icon]} />
            </span>
            <div class="mt-8">
              <h3 class="text-[17px] font-medium text-ink">{f.title}</h3>
              <p class="mt-2 text-[13.5px] leading-[1.5] text-cloud-500">{f.body}</p>
            </div>
          </article>
        ))
      }
    </div>
  </div>
</section>
