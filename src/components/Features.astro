---
// "Why choose Clean Pro" — four feature cards in the shared card language:
// white, rounded-3xl, hairline ink border, tinted icon tile.
import SectionHeading from "./SectionHeading.astro";

const features = [
  {
    title: "Free pickup & delivery",
    body: "We collect your laundry and bring it back clean at a time that suits you — collection and delivery are always free.",
    icon: "truck",
  },
  {
    title: "24-hour turnaround",
    body: "Everyday laundry back at your door the next day, pressed and ready to wear.",
    icon: "clock",
  },
  {
    title: "Gentle, eco-friendly cleaning",
    body: "Plant-based detergents and low-energy machines that are kind to your clothes and the planet.",
    icon: "leaf",
  },
  {
    title: "Handled by real specialists",
    body: "Every item is sorted, inspected and hand-finished by trained cleaners — never a machine on autopilot.",
    icon: "sparkle",
  },
];

const icons = {
  truck:
    '<path d="M3 6h11v9H3zM14 9h4l3 3v3h-7z" /><circle cx="7" cy="18" r="1.6" /><circle cx="17" cy="18" r="1.6" />',
  clock: '<circle cx="12" cy="12" r="8.5" /><path d="M12 7v5l3.5 2" />',
  leaf: '<path d="M5 19c0-8 6-13 15-14-1 9-6 14-14 14" /><path d="M5 19c3-4 7-6 10-7" />',
  sparkle:
    '<path d="M12 3l2 5.5L19.5 10 14 12l-2 5.5L10 12 4.5 10 10 8.5z" /><path d="M18 15.5l.8 2 2 .8-2 .8-.8 2-.8-2-2-.8 2-.8z" />',
};
---

<section id="features" class="bg-white py-20 sm:py-24">
  <div class="container-x">
    <div class="reveal">
      <SectionHeading
        eyebrow="Why Clean Pro"
        title="Laundry, without the"
        highlight="laundry day"
        subtitle="Free doorstep collection, a 24-hour turnaround and specialists who finish every item by hand."
      />
    </div>

    <div class="mt-14 grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
      {
        features.map((f, i) => (
          <article
            class="reveal group flex h-full flex-col rounded-3xl border border-ink-100 bg-white p-7 transition-shadow duration-300 hover:shadow-[0_28px_60px_-40px_rgba(30,33,36,0.5)]"
            style={`animation-delay:${i * 80}ms`}
          >
            <span class="grid size-12 place-items-center rounded-2xl bg-brand-50 text-brand-500 transition-colors duration-300 group-hover:bg-brand-100">
              <svg
                width="22"
                height="22"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="1.7"
                stroke-linecap="round"
                stroke-linejoin="round"
                set:html={icons[f.icon]}
              />
            </span>
            <h3 class="mt-7 font-display text-lg font-extrabold tracking-tight text-ink-900">
              {f.title}
            </h3>
            <p class="mt-3 text-sm leading-relaxed text-ink-500">{f.body}</p>
          </article>
        ))
      }
    </div>
  </div>
</section>
