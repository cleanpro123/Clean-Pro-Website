---
// "Peace of mind" — two guarantee cards plus a wide service-area card.
import SectionHeading from "./SectionHeading.astro";

const guarantees = [
  {
    title: "Satisfaction guarantee",
    body: "If anything comes back less than perfect, we'll re-clean it for free — or refund you. Your happiness is the whole point.",
    icon: '<path d="M12 3 4 6.5v5c0 4.6 3.4 8.4 8 9.5 4.6-1.1 8-4.9 8-9.5v-5Z" /><path d="m9 12 2 2 4-4" />',
  },
  {
    title: "Fully insured & tracked",
    body: "Every order is barcoded, tracked and insured from the moment we collect it to the moment it's back in your hands.",
    icon: '<rect x="3" y="4" width="18" height="16" rx="3" /><path d="M7 8v8M10 8v8M13 8v8M17 8v8" />',
  },
];
---

<section class="bg-ink-50 py-20 sm:py-24">
  <div class="container-x">
    <div class="reveal">
      <SectionHeading
        eyebrow="Peace of mind"
        title="Your clothes,"
        highlight="in safe hands"
        subtitle="Insured, tracked and guaranteed — with same-day slots across 50+ neighborhoods."
      />
    </div>

    <div class="mt-14 grid gap-6 lg:grid-cols-[0.85fr_0.85fr_1.3fr]">
      {
        guarantees.map((g, i) => (
          <article
            class="reveal flex flex-col justify-between rounded-3xl border border-ink-100 bg-white p-7 transition-shadow duration-300 hover:shadow-[0_28px_60px_-40px_rgba(30,33,36,0.5)]"
            style={`animation-delay:${i * 80}ms`}
          >
            <span class="grid size-12 place-items-center rounded-2xl bg-teal-50 text-teal-600">
              <svg
                width="22"
                height="22"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="1.7"
                stroke-linecap="round"
                stroke-linejoin="round"
                set:html={g.icon}
              />
            </span>
            <div class="mt-10">
              <h3 class="font-display text-lg font-extrabold tracking-tight text-ink-900">
                {g.title}
              </h3>
              <p class="mt-3 text-sm leading-relaxed text-ink-500">{g.body}</p>
            </div>
          </article>
        ))
      }

      <!-- Service area -->
      <article
        class="reveal relative flex flex-col justify-between overflow-hidden rounded-3xl border border-ink-100 bg-gradient-to-br from-brand-50 via-white to-teal-50 p-7 sm:p-8"
        style="animation-delay:160ms"
      >
        <div>
          <h3 class="font-display text-xl font-extrabold leading-tight tracking-tight text-ink-900 sm:text-2xl">
            Now serving your neighborhood
          </h3>
          <p class="mt-3 max-w-md text-sm leading-relaxed text-ink-500">
            Clean Pro covers 50+ neighborhoods across the city and we're
            expanding every month. Enter your postcode at checkout to see
            same-day pickup slots.
          </p>
        </div>

        <div class="mt-8 flex w-full min-w-0 flex-col gap-3 sm:flex-row">
          <div
            class="flex w-full min-w-0 flex-1 items-center gap-3 rounded-2xl border border-ink-100 bg-white px-4 py-3 shadow-[0_18px_40px_-30px_rgba(30,33,36,0.6)]"
          >
            <span
              class="grid size-9 shrink-0 place-items-center rounded-full bg-brand-50 text-brand-500"
            >
              <svg
                width="16"
                height="16"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="1.8"
                stroke-linecap="round"
                stroke-linejoin="round"
                ><path d="M12 21s-6.5-5.2-6.5-10A6.5 6.5 0 0 1 18.5 11c0 4.8-6.5 10-6.5 10Z"
                ></path><circle cx="12" cy="11" r="2"></circle></svg
              >
            </span>
            <div class="min-w-0">
              <p class="text-sm font-semibold leading-tight text-ink-900">
                50+ neighborhoods
              </p>
              <p class="text-xs text-ink-400">Same-day pickup slots</p>
            </div>
          </div>

          <div
            class="flex w-full min-w-0 flex-1 items-center gap-3 rounded-2xl border border-ink-100 bg-white px-4 py-3 shadow-[0_18px_40px_-30px_rgba(30,33,36,0.6)]"
          >
            <span
              class="grid size-9 shrink-0 place-items-center rounded-full bg-teal-50 text-teal-600"
            >
              <svg
                width="16"
                height="16"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="1.8"
                stroke-linecap="round"
                stroke-linejoin="round"
                ><circle cx="12" cy="12" r="8.5"></circle><path d="M12 7v5l3.5 2"
                ></path></svg
              >
            </span>
            <div class="min-w-0">
              <p class="text-sm font-semibold leading-tight text-ink-900">
                Open 7 days a week
              </p>
              <p class="text-xs text-ink-400">Early &amp; late slots</p>
            </div>
          </div>
        </div>
      </article>
    </div>
  </div>
</section>
