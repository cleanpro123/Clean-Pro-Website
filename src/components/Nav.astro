---
import Logo from "./Logo.astro";

const services = [
  { label: "Wash & fold", href: "#services" },
  { label: "Dry cleaning", href: "#services" },
  { label: "Ironing & pressing", href: "#services" },
  { label: "Commercial laundry", href: "#services" },
];
---

<header
  id="site-header"
  class="fixed inset-x-0 top-0 z-50 px-3 transition-all duration-500 ease-[cubic-bezier(0.22,1,0.36,1)] sm:px-4"
>
  <!-- Solid white pill floating over the hero card; the shadow deepens once
       the page scrolls under it (#site-header.is-scrolled).
       Layout: wordmark left, pill link group centred, dark CTA at the far right. -->
  <nav
    id="site-nav"
    aria-label="Main"
    class="relative mx-auto flex max-w-[1080px] items-center justify-between gap-4 bg-white py-2 pl-4 pr-2 font-geist transition-all duration-500 ease-[cubic-bezier(0.22,1,0.36,1)] md:grid md:grid-cols-[1fr_auto_1fr] md:pl-6"
  >
    <!-- Left — wordmark -->
    <Logo />

    <!-- Centre — pill link group; the current section sits in a tinted pill -->
    <div
      class="nav-links hidden items-center gap-1 text-[15px] font-medium md:flex md:justify-self-center"
    >
      <a href="#top" class="nav-link is-active rounded-full px-4 py-2">Home</a>

      <div class="group relative">
        <a
          href="#services"
          class="nav-link inline-flex items-center gap-1.5 rounded-full px-4 py-2"
          aria-haspopup="true"
        >
          Services
          <svg
            class="mt-px transition-transform duration-300 group-hover:rotate-180"
            width="12"
            height="12"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2.4"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"><path d="m6 9 6 6 6-6" /></svg
          >
        </a>

        <!-- Hover/focus dropdown. The pt-4 keeps a hover bridge between the
             trigger and the panel so the menu doesn't flicker shut. -->
        <div
          class="invisible absolute left-1/2 top-full -translate-x-1/2 pt-4 opacity-0 transition-all duration-200 group-focus-within:visible group-focus-within:opacity-100 group-hover:visible group-hover:opacity-100"
        >
          <div
            class="w-[228px] rounded-2xl border border-[#ececf3] bg-white p-1.5 shadow-[0_20px_50px_rgba(13,15,41,0.14)]"
          >
            {
              services.map((s) => (
                <a
                  href={s.href}
                  class="block rounded-xl px-3 py-2 text-[14px] text-base-600 transition-colors hover:bg-lav-50 hover:text-navy"
                >
                  {s.label}
                </a>
              ))
            }
          </div>
        </div>
      </div>

      <a href="#how" class="nav-link rounded-full px-4 py-2">How it works</a>
      <a href="#faq" class="nav-link rounded-full px-4 py-2">FAQ</a>
    </div>

    <!-- Right — dark CTA pill -->
    <div class="flex items-center gap-2 md:justify-self-end md:gap-4">
      <a
        href="#contact"
        id="nav-cta"
        class="inline-flex items-center rounded-full bg-ink px-5 py-2.5 text-[14px] font-semibold text-white transition-colors hover:bg-ink-soft md:px-6"
      >
        Book a pickup
      </a>

      <!-- Mobile menu toggle -->
      <button
        id="nav-toggle"
        type="button"
        aria-expanded="false"
        aria-controls="mobile-menu"
        class="grid size-9 place-items-center rounded-full text-navy transition-colors hover:bg-lav-50 md:hidden"
      >
        <span class="sr-only">Toggle menu</span>
        <svg
          width="18"
          height="18"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h16" /></svg
        >
      </button>
    </div>
  </nav>

  <!-- Mobile panel -->
  <div
    id="mobile-menu"
    class="mx-auto mt-2 hidden max-w-[1080px] rounded-2xl border border-[#ececf3] bg-white p-2 font-geist shadow-[0_20px_50px_rgba(13,15,41,0.16)] md:hidden"
  >
    <a
      href="#top"
      class="block rounded-xl px-4 py-2.5 text-[15px] font-medium text-base-600 hover:bg-lav-50 hover:text-navy"
      >Home</a
    >
    <a
      href="#services"
      class="block rounded-xl px-4 py-2.5 text-[15px] font-medium text-base-600 hover:bg-lav-50 hover:text-navy"
      >Services</a
    >
    <a
      href="#how"
      class="block rounded-xl px-4 py-2.5 text-[15px] font-medium text-base-600 hover:bg-lav-50 hover:text-navy"
      >How it works</a
    >
    <a
      href="#faq"
      class="block rounded-xl px-4 py-2.5 text-[15px] font-medium text-base-600 hover:bg-lav-50 hover:text-navy"
      >FAQ</a
    >
  </div>
</header>

<script>
  // Round the bar into a floating pill once the hero's top edge scrolls away.
  const header = document.getElementById("site-header");
  if (header) {
    const onScroll = () => {
      header.classList.toggle("is-scrolled", window.scrollY > 24);
    };
    onScroll();
    window.addEventListener("scroll", onScroll, { passive: true });
  }

  // Move the tinted "current" pill to whichever section is in view.
  const navLinks = Array.from(
    document.querySelectorAll<HTMLAnchorElement>("#site-nav .nav-link"),
  );
  const sections = navLinks
    .map((link) => ({ link, el: document.querySelector(link.hash) }))
    .filter((s): s is { link: HTMLAnchorElement; el: Element } => Boolean(s.el));

  if (sections.length) {
    const setActive = () => {
      const line = window.scrollY + window.innerHeight * 0.3;
      let current = sections[0];
      for (const s of sections) {
        if ((s.el as HTMLElement).offsetTop <= line) current = s;
      }
      navLinks.forEach((l) => l.classList.toggle("is-active", l === current.link));
    };
    setActive();
    window.addEventListener("scroll", setActive, { passive: true });
  }

  const toggle = document.getElementById("nav-toggle");
  const menu = document.getElementById("mobile-menu");
  if (toggle && menu) {
    const setOpen = (open: boolean) => {
      menu.classList.toggle("hidden", !open);
      toggle.setAttribute("aria-expanded", String(open));
    };
    toggle.addEventListener("click", () =>
      setOpen(menu.classList.contains("hidden")),
    );
    // Any link tap navigates within the page, so close the panel behind it.
    menu.querySelectorAll("a").forEach((a) =>
      a.addEventListener("click", () => setOpen(false)),
    );
  }
</script>
