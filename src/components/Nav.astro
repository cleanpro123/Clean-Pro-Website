---
import Logo from "./Logo.astro";
---

<header
  id="site-header"
  class="fixed inset-x-0 top-0 z-50 px-4 pt-3.5 transition-all duration-500 ease-[cubic-bezier(0.22,1,0.36,1)] sm:pt-4"
>
  <!-- The bar is dark glass while it sits over the hero, and flips to light
       glass once the page scrolls past it (see #site-header.is-scrolled). -->
  <nav
    id="site-nav"
    class="relative mx-auto flex max-w-[770px] items-center justify-between gap-4 rounded-full border-[0.5px] border-white/10 bg-white/[0.06] py-1.5 pl-5 pr-2 font-geist shadow-[0_9px_30px_rgba(7,12,30,0.35)] backdrop-blur-2xl transition-all duration-500 ease-[cubic-bezier(0.22,1,0.36,1)]"
  >
    <Logo />

    <div class="flex items-center gap-2 md:gap-5">
      <nav class="nav-links hidden items-center gap-6 font-geist text-sm font-medium md:flex">
        <a href="#services">Services</a>
        <a href="#how">How it works</a>
        <a href="#faq">FAQ</a>
      </nav>

      <div class="flex items-center gap-1">
        <a
          href="#contact"
          id="nav-cta"
          class="rounded-full px-4 py-1.5 text-sm font-semibold transition-colors"
        >
          Book a pickup
        </a>
      </div>
    </div>
  </nav>
</header>

<script>
  // Flip the bar from dark glass (over the hero) to light glass once scrolled.
  const header = document.getElementById("site-header");
  if (header) {
    const onScroll = () => {
      header.classList.toggle("is-scrolled", window.scrollY > 24);
    };
    onScroll();
    window.addEventListener("scroll", onScroll, { passive: true });
  }
</script>
