---
// Locations — office cards beside a Leaflet map, built to match the Saj
// Innovative section: clicking "Show on map" flies to that branch and opens its
// popup, clicking the same card again (or "Show all locations") zooms back out
// to fit every pin. The map uses CARTO's light basemap and falls back to plain
// OpenStreetMap tiles if CARTO fails to answer.
//
// ─────────────────────────────────────────────────────────────────────────────
// TODO: placeholder branch — West Bay, Doha, picked as an example. Street
// address, hours, numbers and email are all invented and need the real ones.
// `coords` is [latitude, longitude]; it places the pin AND sets the map's
// opening view, so it has to be right or the map opens over the wrong district.
// Adding a second entry needs no other change — the heading, the reset button
// and the map's framing all key off this list's length.
// ─────────────────────────────────────────────────────────────────────────────
const locations = [
  {
    id: "west-bay",
    name: "Clean Pro Doha",
    city: "West Bay",
    address: [
      "Office 12, Al Fardan Office Tower",
      "West Bay, Al Dafna — Zone 61",
      "Doha, Qatar",
    ],
    hours: ["Saturday – Thursday : 7am to 9pm", "Friday : 2pm to 9pm"],
    mobile: "+974 5555 0142",
    phone: "+974 4455 0143",
    email: "hello@cleanpro.qa",
    coords: [25.3204, 51.529],
  },
].map((office) => ({
  ...office,
  mapHref: `https://www.google.com/maps/dir/?api=1&destination=${office.coords[0]},${office.coords[1]}`,
}));

const single = locations.length === 1;

// Single-path line icons, same set the reference section uses.
const icons = {
  pin: "M12 21s7-5.6 7-11a7 7 0 10-14 0c0 5.4 7 11 7 11zm0-8.5a2.8 2.8 0 100-5.6 2.8 2.8 0 000 5.6z",
  clock: "M12 21a9 9 0 100-18 9 9 0 000 18zm0-14v5l3.5 2",
  mobile: "M8 2.5h8a1.5 1.5 0 011.5 1.5v16a1.5 1.5 0 01-1.5 1.5H8A1.5 1.5 0 016.5 20V4A1.5 1.5 0 018 2.5zM10 5.5h4M12 18h.01",
  phone: "M6.5 3.5h3l1.5 4-2 1.4a12 12 0 006.1 6.1l1.4-2 4 1.5v3a2 2 0 01-2.2 2A16.5 16.5 0 014.5 5.7a2 2 0 012-2.2z",
  mail: "M3.5 6h17a1 1 0 011 1v10a1 1 0 01-1 1h-17a1 1 0 01-1-1V7a1 1 0 011-1zm.4.6L12 13l8.1-6.4",
};
---

<link
  rel="stylesheet"
  href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css"
  integrity="sha256-p4NxAoJBhIIN+hmNHrzRCf9tD/miZyoHS5obTRR9BMY="
  crossorigin=""
/>
<script
  is:inline
  defer
  src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"
  integrity="sha256-20nQCchB9co0qIjJZRGuk2/Z9VM+kNiyxNV1lvTlZBo="
  crossorigin=""></script>

<section id="locations" class="bg-white px-3 sm:px-5 lg:px-6">
  <div class="rounded-2xl bg-ink-50 py-20 sm:rounded-3xl sm:py-24">
    <div class="mx-auto w-full max-w-7xl px-6 sm:px-10 lg:px-16">
      <div class="reveal flex flex-wrap items-end justify-between gap-4">
        <h2
          class="font-display text-2xl font-extrabold tracking-tight text-ink-900"
        >
          {single ? "Our location" : "Our locations"}
        </h2>
        {
          /* Nothing to zoom back out to with a single pin, so the reset only
             earns its place once there is more than one. */
          !single && (
            <button
              type="button"
              id="locations-reset"
              hidden
              class="text-xs font-semibold text-brand-500 underline underline-offset-4 transition-colors hover:text-brand-700"
            >
              Show all locations
            </button>
          )
        }
      </div>

      <div class="mt-6 grid gap-5 lg:grid-cols-[1fr_1.1fr]">
        <!-- Office cards -->
        <div class="reveal grid gap-5">
          {
            locations.map((office) => (
              <article
                data-office={office.id}
                class="office-card rounded-2xl border border-ink-200/60 bg-white p-6 transition-all duration-300 hover:border-brand-200"
              >
                <div class="flex items-start justify-between gap-4">
                  <h3 class="font-display text-base font-bold text-ink-900">
                    {office.name}
                    <span class="text-brand-500"> | {office.city}</span>
                  </h3>
                  <button
                    type="button"
                    class="office-toggle shrink-0 rounded-full bg-ink-100 px-3 py-1.5 text-[11px] font-semibold text-ink-600 transition-colors hover:bg-brand-100 hover:text-brand-600"
                    aria-pressed="false"
                  >
                    Show on map
                  </button>
                </div>

                <ul class="mt-5 space-y-4 text-sm">
                  <li class="flex gap-3">
                    <span class="mt-0.5 shrink-0 text-brand-500">
                      <svg
                        class="h-4 w-4"
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="1.6"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        aria-hidden="true"
                      >
                        <path d={icons.pin} />
                      </svg>
                    </span>
                    <span class="text-ink-600">
                      {office.address.map((line) => (
                        <span class="block">{line}</span>
                      ))}
                    </span>
                  </li>

                  <li class="flex gap-3">
                    <span class="mt-0.5 shrink-0 text-brand-500">
                      <svg
                        class="h-4 w-4"
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="1.6"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        aria-hidden="true"
                      >
                        <path d={icons.clock} />
                      </svg>
                    </span>
                    <span class="text-ink-600">
                      {office.hours.map((line) => (
                        <span class="block">{line}</span>
                      ))}
                    </span>
                  </li>

                  <li class="flex flex-wrap items-center gap-x-6 gap-y-2">
                    <a
                      href={`tel:${office.mobile.replace(/[^+\d]/g, "")}`}
                      class="flex items-center gap-2 text-ink-600 transition-colors hover:text-brand-600"
                    >
                      <svg
                        class="h-4 w-4 text-brand-500"
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="1.6"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        aria-hidden="true"
                      >
                        <path d={icons.mobile} />
                      </svg>
                      {office.mobile}
                    </a>
                    <a
                      href={`tel:${office.phone.replace(/[^+\d]/g, "")}`}
                      class="flex items-center gap-2 text-ink-600 transition-colors hover:text-brand-600"
                    >
                      <svg
                        class="h-4 w-4 text-brand-500"
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="1.6"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        aria-hidden="true"
                      >
                        <path d={icons.phone} />
                      </svg>
                      {office.phone}
                    </a>
                  </li>

                  <li class="flex flex-wrap items-center justify-between gap-x-6 gap-y-2">
                    <a
                      href={`mailto:${office.email}`}
                      class="flex items-center gap-2 text-ink-600 transition-colors hover:text-brand-600"
                    >
                      <svg
                        class="h-4 w-4 text-brand-500"
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="1.6"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        aria-hidden="true"
                      >
                        <path d={icons.mail} />
                      </svg>
                      {office.email}
                    </a>
                    <a
                      href={office.mapHref}
                      target="_blank"
                      rel="noreferrer"
                      class="group inline-flex items-center gap-2 text-xs font-semibold text-brand-500 transition-colors hover:text-brand-700"
                    >
                      Get directions
                      <svg
                        width="16"
                        height="16"
                        viewBox="0 0 16 16"
                        fill="none"
                        aria-hidden="true"
                        class="transition-transform duration-300 group-hover:translate-x-1"
                      >
                        <path
                          d="M3 8h10M9 4l4 4-4 4"
                          stroke="currentColor"
                          stroke-width="1.7"
                          stroke-linecap="round"
                          stroke-linejoin="round"
                        />
                      </svg>
                    </a>
                  </li>
                </ul>
              </article>
            ))
          }
        </div>

        <!-- Map -->
        <div
          class:list={[
            "lg:sticky lg:top-32 lg:self-start",
            single
              ? "lg:h-[28rem]"
              : "lg:h-[calc(100vh-10rem)] lg:max-h-[44rem]",
          ]}
        >
          <div
            id="locations-map"
            role="application"
            aria-label="Map showing every Clean Pro location"
            class="relative z-0 h-[24rem] min-h-[22rem] w-full overflow-hidden rounded-2xl border border-ink-200/60 bg-ink-100 lg:h-full"
          >
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<style is:global>
  /* Leaflet's popup chrome, restyled to match the section's cards. */
  #locations-map .leaflet-popup-content-wrapper {
    border-radius: 0.75rem;
    box-shadow: 0 24px 50px -30px rgba(30, 33, 36, 0.45);
  }
  #locations-map .leaflet-popup-content {
    margin: 0.875rem 1rem;
  }
  #locations-map .leaflet-container {
    font-family: inherit;
  }
</style>

<script is:inline define:vars={{ locations }}>
  document.addEventListener("DOMContentLoaded", () => {
    const container = document.getElementById("locations-map");
    // Leaflet is loaded from a CDN — if it never arrives, leave the cards alone
    // rather than throwing and taking the rest of the page's scripts with it.
    if (!container || typeof window.L === "undefined") return;

    const L = window.L;
    const FIT = { padding: [56, 56], maxZoom: 12 };
    const bounds = () => L.latLngBounds(locations.map((o) => o.coords));

    // Fitting bounds to a single point lands on FIT.maxZoom, which is a whole
    // country's worth of context for one branch — frame that case by hand.
    const SOLO_ZOOM = 14;
    const frameAll = (animate) => {
      if (locations.length === 1) {
        if (animate) map.flyTo(locations[0].coords, SOLO_ZOOM, { duration: 0.6 });
        else map.setView(locations[0].coords, SOLO_ZOOM);
        return;
      }
      if (animate) map.flyToBounds(bounds(), { ...FIT, duration: 0.6 });
      else map.fitBounds(bounds(), FIT);
    };

    // Teardrop pin; turns teal while its card is the active one.
    const pinIcon = (active) =>
      L.divIcon({
        className: "",
        iconSize: [30, 38],
        iconAnchor: [15, 38],
        popupAnchor: [0, -34],
        html: `
      <span class="block h-[38px] w-[30px] transition-transform duration-200 ${active ? "scale-110" : ""}">
        <svg viewBox="0 0 30 38" width="30" height="38" aria-hidden="true">
          <path d="M15 37C15 37 28 23.6 28 14A13 13 0 002 14c0 9.6 13 23 13 23z"
            fill="${active ? "#14b8a6" : "#3a76b8"}" stroke="#ffffff" stroke-width="2.5"
            stroke-linejoin="round" />
          <circle cx="15" cy="14" r="4.6" fill="#ffffff" />
        </svg>
      </span>`,
      });

    const popupHtml = (o) => `
    <p class="!m-0 text-[13px] font-bold text-ink-900">${o.name} · ${o.city}</p>
    <p class="!mt-1 !mb-2 text-[12px] leading-snug text-ink-500">${o.address.join("<br />")}</p>
    <a href="${o.mapHref}" target="_blank" rel="noreferrer"
       class="text-[12px] font-semibold text-brand-500 underline underline-offset-2">Get directions</a>`;

    // No attribution control: the map should read as part of the page rather
    // than as a third-party embed. The tile layers below still carry their
    // attribution strings, so restoring the control is a one-word change.
    const map = L.map(container, {
      scrollWheelZoom: false,
      zoomControl: true,
      attributionControl: false,
    });

    const carto = L.tileLayer(
      "https://{s}.basemaps.cartocdn.com/light_all/{z}/{x}/{y}{r}.png",
      {
        maxZoom: 19,
        detectRetina: true,
        attribution: "&copy; OpenStreetMap contributors &copy; CARTO",
      }
    ).addTo(map);

    // If CARTO is unreachable, swap the whole layer for vanilla OSM once.
    let tileErrors = 0;
    let swapped = false;
    carto.on("tileerror", () => {
      tileErrors += 1;
      if (swapped || tileErrors < 3) return;
      swapped = true;
      map.removeLayer(carto);
      L.tileLayer("https://tile.openstreetmap.org/{z}/{x}/{y}.png", {
        maxZoom: 19,
        attribution: "&copy; OpenStreetMap contributors",
      }).addTo(map);
    });

    const markers = {};
    let activeId = null;

    const cards = Array.from(document.querySelectorAll(".office-card"));
    const resetBtn = document.getElementById("locations-reset");

    const paint = () => {
      locations.forEach((o) => markers[o.id]?.setIcon(pinIcon(o.id === activeId)));

      cards.forEach((card) => {
        const on = card.dataset.office === activeId;
        card.classList.toggle("border-brand-400", on);
        card.classList.toggle("shadow-[0_24px_50px_-30px_rgba(30,33,36,0.45)]", on);
        card.classList.toggle("border-ink-200/60", !on);
        card.classList.toggle("hover:border-brand-200", !on);

        const btn = card.querySelector(".office-toggle");
        if (!btn) return;
        btn.textContent = on ? "Shown on map" : "Show on map";
        btn.setAttribute("aria-pressed", String(on));
        btn.classList.toggle("bg-brand-500", on);
        btn.classList.toggle("text-white", on);
        btn.classList.toggle("bg-ink-100", !on);
        btn.classList.toggle("text-ink-600", !on);
        btn.classList.toggle("hover:bg-brand-100", !on);
        btn.classList.toggle("hover:text-brand-600", !on);
      });

      if (resetBtn) resetBtn.hidden = activeId === null;
    };

    const select = (id) => {
      activeId = activeId === id ? null : id;
      paint();

      if (activeId === null) {
        frameAll(true);
        return;
      }
      const office = locations.find((o) => o.id === activeId);
      const marker = markers[activeId];
      if (!office || !marker) return;
      map.flyTo(office.coords, 15, { duration: 0.7 });
      marker.openPopup();
    };

    locations.forEach((o) => {
      const marker = L.marker(o.coords, {
        icon: pinIcon(false),
        title: `${o.name} — ${o.city}`,
      })
        .addTo(map)
        .bindPopup(popupHtml(o), { closeButton: false })
        .bindTooltip(o.city, { direction: "top", offset: [0, -34] });
      marker.on("click", () => select(o.id));
      markers[o.id] = marker;
    });

    frameAll(false);

    cards.forEach((card) => {
      const btn = card.querySelector(".office-toggle");
      btn?.addEventListener("click", () => select(card.dataset.office));
    });
    resetBtn?.addEventListener("click", () => {
      activeId = null;
      paint();
      frameAll(true);
    });

    // Wheel-scrolling the page shouldn't zoom the map until it's been clicked.
    map.on("click", () => map.scrollWheelZoom.enable());
    container.addEventListener("mouseleave", () => map.scrollWheelZoom.disable());

    // The map is laid out inside a sticky column, so its box can settle after
    // first paint; recompute size and refit once it actually has height.
    let fitted = false;
    new ResizeObserver(() => {
      map.invalidateSize({ animate: false });
      if (!fitted && container.clientHeight > 0) {
        fitted = true;
        if (activeId === null) frameAll(false);
      }
    }).observe(container);

    paint();
  });
</script>
