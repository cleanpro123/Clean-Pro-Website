---
// Fresh gradient section holding the Clean Pro booking-assistant demo, clipped
// at the section's bottom edge.
import ProductDemo from "./ProductDemo.astro";
---

<section id="cta-banner" class="relative overflow-hidden m-4 mb-0 rounded-[14px]">
  <!-- Fresh gradient backdrop -->
  <div
    class="absolute inset-0"
    aria-hidden="true"
    style="background:linear-gradient(180deg,#0C1A3A 0%,#1c4a8f 34%,#2f7ad0 58%,#7cb5ec 82%,#7cb5ec 100%)"
  >
  </div>

  <div class="relative flex flex-col items-center px-6 pt-16 sm:pt-24">
    <!-- Booking-assistant demo, clipped at the section's bottom edge -->
    <div
      class="reveal h-[57vh] max-h-[480px] min-h-[380px] w-full max-w-[925px] overflow-hidden rounded-t-[14px] shadow-[0_-20px_60px_rgba(12,26,58,0.35)]"
    >
      <ProductDemo />
    </div>
  </div>
</section>
