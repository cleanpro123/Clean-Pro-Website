---
// Fresh gradient section holding the Clean Pro booking-assistant demo, clipped
// at the section's bottom edge.
import ProductDemo from "./ProductDemo.astro";
---

<section
  id="cta-banner"
  data-dock-dark
  class="relative overflow-hidden m-4 mb-0 rounded-3xl"
>
  <!-- Fresh gradient backdrop -->
  <div
    class="absolute inset-0"
    aria-hidden="true"
    style="background:linear-gradient(180deg,#1e2124 0%,#244b78 34%,#2e6099 62%,#5a95d1 88%,#5a95d1 100%)"
  >
  </div>

  <div class="relative flex flex-col items-center px-6 pt-16 sm:pt-24">
    <!-- Booking-assistant demo, clipped at the section's bottom edge -->
    <div
      class="reveal h-[57vh] max-h-[480px] min-h-[380px] w-full max-w-[925px] overflow-hidden rounded-t-3xl shadow-[0_-20px_60px_rgba(30,33,36,0.35)]"
    >
      <ProductDemo />
    </div>
  </div>
</section>
