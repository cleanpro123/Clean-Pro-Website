---
// Footer — same shape as the Saj Innovative site: a dark rounded card floating
// on white, brand column beside the link columns, a highlight panel, a bottom
// bar with legal links + socials, and the oversized wordmark watermark bleeding
// out beneath the card.
import Logo from "./Logo.astro";

const columns = [
  {
    heading: "Services",
    links: [
      { label: "Wash & fold", href: "#services" },
      { label: "Dry cleaning", href: "#services" },
      { label: "Ironing & pressing", href: "#services" },
      { label: "Commercial laundry", href: "#services" },
    ],
  },
  {
    heading: "Company",
    links: [
      { label: "How it works", href: "#how" },
      { label: "Why Clean Pro", href: "#services" },
      { label: "FAQ", href: "#faq" },
      { label: "Book a pickup", href: "#contact" },
    ],
  },
  {
    heading: "Get in touch",
    links: [
      { label: "hello@cleanpro.com", href: "mailto:hello@cleanpro.com" },
      { label: "+1 (800) 555-0142", href: "tel:+18005550142" },
      { label: "128 Riverside Avenue", href: "#contact" },
      { label: "Imprint", href: "/imprint" },
    ],
  },
];

// TODO: swap in the real profile URLs once the accounts are live.
const socials = [
  {
    label: "Facebook",
    href: "#",
    path: "M13.5 21v-8h2.7l.4-3.1h-3.1V7.9c0-.9.25-1.5 1.55-1.5H16.7V3.6A21 21 0 0 0 14.3 3.5c-2.4 0-4 1.45-4 4.1v2.3H7.6V13h2.7v8h3.2Z",
  },
  {
    label: "X",
    href: "#",
    path: "M17.7 3h3.3l-7.2 8.2L22 21h-6.6l-4.3-5.6L6.2 21H2.9l7.7-8.8L2.6 3h6.8l3.9 5.1L17.7 3Zm-1.2 16h1.8L7.6 4.9H5.6L16.5 19Z",
  },
  {
    label: "Instagram",
    href: "#",
    path: "M12 7.4a4.6 4.6 0 1 0 0 9.2 4.6 4.6 0 0 0 0-9.2Zm0 7.6a3 3 0 1 1 0-6 3 3 0 0 1 0 6Zm5.9-7.8a1.07 1.07 0 1 1-2.15 0 1.07 1.07 0 0 1 2.15 0ZM21 8.6c0-1.5-.37-2.8-1.45-3.9C18.47 3.6 17.15 3.25 15.65 3.2 14.1 3.1 9.9 3.1 8.35 3.2c-1.5.05-2.8.4-3.9 1.5C3.37 5.8 3 7.1 3 8.6c-.1 1.55-.1 5.75 0 7.3.05 1.5.4 2.8 1.45 3.9 1.1 1.1 2.4 1.45 3.9 1.5 1.55.1 5.75.1 7.3 0 1.5-.05 2.8-.4 3.9-1.5 1.08-1.1 1.45-2.4 1.45-3.9.1-1.55.1-5.75 0-7.3Zm-1.9 8.95a3 3 0 0 1-1.7 1.7c-1.2.47-4 .36-5.4.36-1.4 0-4.2.1-5.4-.36a3 3 0 0 1-1.7-1.7c-.47-1.2-.36-4-.36-5.4 0-1.4-.1-4.2.36-5.4a3 3 0 0 1 1.7-1.7c1.2-.47 4-.36 5.4-.36 1.4 0 4.2-.1 5.4.36a3 3 0 0 1 1.7 1.7c.47 1.2.36 4 .36 5.4 0 1.4.1 4.2-.36 5.4Z",
  },
];

const year = new Date().getFullYear();
---

<footer class="bg-white">
  <div
    class="relative overflow-hidden rounded-t-[1.75rem] bg-white pt-14 sm:rounded-t-[2.25rem] sm:pt-16"
  >
    <div class="relative mx-auto w-full max-w-7xl px-4 sm:px-8 lg:px-10">
      <!-- Footer card -->
      <div
        class="relative z-10 rounded-3xl bg-ink px-7 py-12 shadow-[0_28px_70px_-40px_rgba(13,15,41,0.55)] sm:px-12 sm:py-14"
      >
        <div class="grid gap-12 lg:grid-cols-[1.15fr_1.4fr] lg:gap-16">
          <!-- Brand -->
          <div>
            <Logo variant="light" />

            <p class="mt-6 max-w-md text-sm leading-relaxed text-white/65">
              Clean Pro takes laundry off your list — free pickup and delivery,
              24-hour turnaround and gentle, plant-based cleaning, handled by
              trained specialists who treat every item like their own.
            </p>
          </div>

          <!-- Link columns -->
          <div
            class="grid grid-cols-2 gap-8 sm:grid-cols-3 lg:justify-items-end"
          >
            {
              columns.map((column) => (
                <div>
                  <h3 class="font-display text-base font-bold text-white">
                    {column.heading}
                  </h3>
                  <ul class="mt-5 space-y-3">
                    {column.links.map((link) => (
                      <li>
                        <a
                          href={link.href}
                          class="text-sm text-white/65 transition-colors hover:text-white"
                        >
                          {link.label}
                        </a>
                      </li>
                    ))}
                  </ul>
                </div>
              ))
            }
          </div>
        </div>

        <!-- Highlight panel, sitting on its own above the rule -->
        <div
          class="mt-10 flex w-full max-w-xl items-center gap-5 rounded-2xl border border-white/15 bg-white/5 p-5 sm:gap-6 sm:p-6"
        >
          <div>
            <p class="text-base font-semibold text-white">
              Book by phone · Same-day pickup
            </p>
            <p class="mt-1.5 text-sm text-white/60">
              <a
                href="tel:+18005550142"
                class="transition-colors hover:text-white">+1 (800) 555-0142</a
              > · Mon–Sat, 7am–9pm
            </p>
          </div>
        </div>

        <!-- Bottom bar — copyright, legal links and socials -->
        <div
          class="mt-8 flex flex-col gap-5 border-t border-white/15 pt-6 lg:flex-row lg:items-center lg:justify-between"
        >
          <p class="text-sm text-white/60">
            © {year} Clean Pro Laundry Co. All rights reserved.
          </p>

          <div class="flex flex-col gap-5 sm:flex-row sm:items-center sm:gap-7">
            <ul class="flex flex-wrap items-center gap-x-8 gap-y-2">
              <li>
                <a
                  href="/imprint"
                  class="text-sm text-white/70 underline underline-offset-4 transition-colors hover:text-white"
                  >Imprint</a
                >
              </li>
              <li>
                <a
                  href="/imprint#copyright"
                  class="text-sm text-white/70 underline underline-offset-4 transition-colors hover:text-white"
                  >Copyright</a
                >
              </li>
              <li>
                <a
                  href="/imprint#dispute"
                  class="text-sm text-white/70 underline underline-offset-4 transition-colors hover:text-white"
                  >Disputes</a
                >
              </li>
            </ul>

            <span
              aria-hidden="true"
              class="hidden h-4 w-px bg-white/15 sm:block"></span>

            <ul class="flex items-center gap-4">
              {
                socials.map((social) => (
                  <li>
                    <a
                      href={social.href}
                      target="_blank"
                      rel="noreferrer"
                      aria-label={social.label}
                      class="flex text-white transition-colors hover:text-accent"
                    >
                      <svg
                        width="20"
                        height="20"
                        viewBox="0 0 24 24"
                        fill="currentColor"
                        aria-hidden="true"
                      >
                        <path d={social.path} />
                      </svg>
                    </a>
                  </li>
                ))
              }
            </ul>
          </div>
        </div>
      </div>
    </div>

    <!-- Oversized watermark peeking out beneath the card -->
    <div
      aria-hidden="true"
      class="pointer-events-none relative -mt-8 flex select-none justify-center overflow-hidden"
      style="mask-image:linear-gradient(to bottom,#000 18%,rgba(0,0,0,0.35) 68%,transparent 96%);-webkit-mask-image:linear-gradient(to bottom,#000 18%,rgba(0,0,0,0.35) 68%,transparent 96%)"
    >
      <span
        class="translate-y-[22%] whitespace-nowrap font-display text-[14vw] font-extrabold leading-none tracking-tight text-lav-200"
        >clean pro</span
      >
    </div>
  </div>
</footer>

<!-- Floating back-to-top, same as the Saj site -->
<button
  id="back-to-top"
  type="button"
  aria-label="Back to top"
  aria-hidden="true"
  tabindex="-1"
  class="group pointer-events-none fixed bottom-5 right-5 z-40 grid size-12 translate-y-4 place-items-center rounded-full bg-ink text-white opacity-0 shadow-[0_18px_40px_-16px_rgba(13,15,41,0.7)] transition-all duration-300 hover:bg-accent sm:bottom-8 sm:right-8 sm:size-14"
>
  <svg
    width="18"
    height="18"
    viewBox="0 0 18 18"
    fill="none"
    stroke="currentColor"
    stroke-width="1.8"
    stroke-linecap="round"
    stroke-linejoin="round"
    aria-hidden="true"
    class="transition-transform duration-300 group-hover:-translate-y-0.5"
    ><path d="M9 15V3M4 8l5-5 5 5"></path></svg
  >
</button>

<script>
  // Only worth showing once the visitor is well past the hero.
  const btn = document.getElementById("back-to-top");
  if (btn) {
    const onScroll = () => {
      const visible = window.scrollY > window.innerHeight * 0.8;
      btn.classList.toggle("pointer-events-none", !visible);
      btn.classList.toggle("opacity-0", !visible);
      btn.classList.toggle("translate-y-4", !visible);
      btn.setAttribute("aria-hidden", String(!visible));
      btn.setAttribute("tabindex", visible ? "0" : "-1");
    };
    onScroll();
    window.addEventListener("scroll", onScroll, { passive: true });

    btn.addEventListener("click", () => {
      const reduced = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
      window.scrollTo({ top: 0, behavior: reduced ? "auto" : "smooth" });
    });
  }
</script>
