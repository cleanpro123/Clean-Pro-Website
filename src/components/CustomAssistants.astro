---
// "Our services" — one big feature card plus two dark service cards.
---

<section id="services" class="bg-lav-50/60 py-14 sm:py-20">
  <div class="mx-auto max-w-6xl px-6">
    <!-- header -->
    <div class="reveal mb-9 flex flex-col items-start gap-2.5 sm:mb-14">
      <span class="inline-flex items-center rounded-[40px] bg-[#eeeef0] px-3.5 py-1.5 text-[12px] font-medium text-[#0d0f29]">
        Every fabric, handled with care
      </span>
      <h2 class="font-display text-[clamp(1.7rem,3.4vw,2.4rem)] font-normal leading-tight tracking-[-0.03em] text-[#0d0f29]">
        Services for your whole home
      </h2>
    </div>

    <!-- cards — big card full width; the two dark cards sit 2-up on phones -->
    <div class="reveal grid grid-cols-2 gap-4 lg:grid-cols-4">
      <!-- big card -->
      <article
        class="col-span-2 flex min-h-[180px] flex-col justify-between rounded-2xl border border-[#d6d6ec] p-6 sm:min-h-[280px] sm:p-7 lg:min-h-[360px]"
        style="background-image:linear-gradient(-57.34deg,#cfe3fa 0%,#ffffff 98.6%)"
      >
        <div>
          <span class="inline-flex items-center rounded-full bg-white/70 px-3 py-1 text-[12px] font-medium text-navy">From €1.90/kg</span>
          <h3 class="mt-4 max-w-[16ch] text-[22px] font-medium leading-[1.2] text-[#121438] sm:text-[26px] lg:text-[30px]">
            Wash &amp; Fold
          </h3>
        </div>
        <p class="mt-5 max-w-[38ch] text-[13px] font-medium leading-[1.45] text-[#404276] sm:mt-8 sm:text-[15px]">
          Your everyday laundry washed, dried and neatly folded — sorted by colour
          and fabric, and ready to put straight back in the drawer.
        </p>
      </article>

      <!-- dark card 2 -->
      <article class="flex min-h-[200px] flex-col justify-between rounded-2xl bg-[#404276] p-6 sm:min-h-[260px] sm:p-7 lg:min-h-[360px]">
        <h3 class="text-[13px] font-medium leading-[1.2] text-white sm:text-[20px] lg:text-[24px]">
          Dry Cleaning
        </h3>
        <p class="mt-4 text-[11px] font-medium leading-[1.45] text-[#d6d6ec] sm:mt-8 sm:text-[15px]">
          Suits, dresses and delicate fabrics expertly cleaned and hand-finished,
          then returned pressed and protected on hangers.
        </p>
      </article>

      <!-- dark card 3 -->
      <article class="flex min-h-[200px] flex-col justify-between rounded-2xl bg-[#404276] p-6 sm:min-h-[260px] sm:p-7 lg:min-h-[360px]">
        <h3 class="text-[13px] font-medium leading-[1.2] text-white sm:text-[20px] lg:text-[24px]">
          Ironing &amp; Bedding
        </h3>
        <p class="mt-4 text-[11px] font-medium leading-[1.45] text-[#d6d6ec] sm:mt-8 sm:text-[15px]">
          Crisp, ready-to-wear shirts plus freshly laundered duvets, sheets and
          towels — the finishing touches that make home feel new.
        </p>
      </article>
    </div>
  </div>
</section>
