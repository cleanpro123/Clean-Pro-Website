---
// Contact — Saj Innovative layout: shared section heading, then a two-up block
// on a light grey band. Left is a tall navy→teal gradient panel (contact
// channels plus a glass card pinned to its bottom edge); right is a white form
// card with stacked label / input / helper rows and a dark Submit pill.
import SectionHeading from "./SectionHeading.astro";

const socials = [
  {
    name: "LinkedIn",
    d: "M4 8h3v12H4zM5.5 3.5A1.75 1.75 0 1 0 5.5 7 1.75 1.75 0 0 0 5.5 3.5ZM10 8h3v1.7c.5-.9 1.7-1.9 3.5-1.9 3 0 4 2 4 4.7V20h-3v-6c0-1.4-.5-2.4-1.8-2.4S13 12.6 13 14v6h-3z",
    link: "https://www.linkedin.com/",
  },
];

const labelClass = "block text-[14px] font-semibold text-ink-900";
const inputClass =
  "mt-2 w-full rounded-xl border border-ink-200 bg-white px-4 py-3 text-[15px] text-ink-900 transition-colors placeholder:text-ink-400 focus:border-brand-500 focus:outline-none focus:ring-4 focus:ring-brand-500/10";
const helpClass = "mt-2 text-[13px] text-ink-500";

// Web3Forms access key — submissions are emailed to the address this key was
// created for (nihal@peweo.com). The key is public by design (it ships in the
// client HTML); the env var just lets it be swapped without a code change. remove after
const WEB3FORMS_KEY = import.meta.env.PUBLIC_WEB3FORMS_KEY;
---

<section
  id="contact"
  class="relative w-full overflow-hidden bg-ink-50 px-4 py-20 sm:px-6 sm:py-24"
>
  <div class="relative mx-auto w-full max-w-[1080px]">
    <SectionHeading
      class="reveal"
      eyebrow="Contact"
      title="Let's get your laundry"
      highlight="sorted"
      subtitle="Tell us what needs cleaning and where to collect it — we'll confirm your pickup window the same day."
    />

    <div class="mt-12 grid grid-cols-1 gap-5 lg:grid-cols-2 lg:gap-6">
      <!-- Left — gradient panel -->
      <div
        class="reveal relative flex min-h-[440px] flex-col justify-between overflow-hidden rounded-3xl p-7 sm:p-9"
        style="background:linear-gradient(150deg,#1e2124 0%,#244b78 38%,#2e6099 66%,#14b8a6 100%)"
      >
        <div>
          <h3 class="font-display text-2xl font-extrabold text-white">
            Talk to a real person
          </h3>
          <p class="mt-3 max-w-[360px] text-[15px] leading-relaxed text-white/70">
            Prefer not to fill in a form? Copy an address below or call the shop
            — we answer seven days a week.
          </p>

          <p class="mt-7 text-[15px] leading-7 text-white/80">
            Clean Pro Laundry Co.<br />
            128 Riverside Avenue, Downtown District<br />
            Open 7 days · 7am–9pm
          </p>

          <div class="mt-6 flex gap-2">
            {
              socials.map((s) => (
                <a
                  href={s.link}
                  aria-label={s.name}
                  class="grid h-9 w-9 place-items-center rounded-full border border-white/15 bg-white/10 text-white transition hover:bg-white/20"
                >
                  <svg
                    width="18"
                    height="18"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="1.6"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  >
                    <path d={s.d} />
                  </svg>
                </a>
              ))
            }
          </div>
        </div>

        <!-- Glass card pinned to the bottom edge of the panel -->
        <div
          class="mt-10 flex items-center gap-4 rounded-2xl border border-white/15 bg-white/10 p-4 backdrop-blur-md"
        >
          <span
            class="grid size-14 shrink-0 place-items-center rounded-xl bg-white text-brand-500"
          >
            <svg
              width="24"
              height="24"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.8"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
              ><path
                d="M5 4h4l2 5-2.5 1.5a11 11 0 0 0 5 5L15 13l5 2v4a1 1 0 0 1-1 1A16 16 0 0 1 4 5a1 1 0 0 1 1-1Z"
              ></path></svg
            >
          </span>
          <div class="min-w-0">
            <p class="text-[15px] font-semibold text-white">
              Call or text · 7am–9pm
            </p>
            <div class="mt-1 flex flex-wrap items-center gap-x-3 gap-y-1">
              <button
                type="button"
                data-copy="+1 (800) 555-0142"
                class="copy-pill text-[13px] text-white/75 transition hover:text-white"
                >+1 (800) 555-0142</button
              >
              <span class="text-white/30" aria-hidden="true">·</span>
              <button
                type="button"
                data-copy="hello@cleanpro.com"
                class="copy-pill text-[13px] text-white/75 transition hover:text-white"
                >hello@cleanpro.com</button
              >
            </div>
          </div>
        </div>
      </div>

      <!-- Right — form card -->
      <div
        class="reveal rounded-3xl border border-ink-100 bg-white p-6 shadow-[0_20px_60px_rgba(30,33,36,0.08)] sm:p-9"
      >
        <form id="contact-form">
          <!-- Web3Forms config (delivers to nihal@peweo.com via the access key) -->
          <input type="hidden" name="access_key" value={WEB3FORMS_KEY} />
          <input
            type="hidden"
            name="subject"
            value="New Clean Pro contact form submission"
          />
          <input type="hidden" name="from_name" value="Clean Pro website" />
          <!-- honeypot: bots fill this, humans never see it -->
          <input
            type="checkbox"
            name="botcheck"
            tabindex="-1"
            autocomplete="off"
            class="hidden"
            style="display:none"
            aria-hidden="true"
          />

          <div class="space-y-5">
            <div>
              <label for="contact-name" class={labelClass}>
                Your name <span class="text-teal-600">*</span>
              </label>
              <input
                id="contact-name"
                type="text"
                name="name"
                required
                placeholder="Jane Doe"
                autocomplete="name"
                class={inputClass}
              />
            </div>

            <div>
              <label for="contact-email" class={labelClass}>
                Email address <span class="text-teal-600">*</span>
              </label>
              <input
                id="contact-email"
                type="email"
                name="email"
                required
                placeholder="you@example.com"
                autocomplete="email"
                class={inputClass}
              />
              <p class={helpClass}>Where we send your pickup confirmation.</p>
            </div>

            <div>
              <label for="contact-phone" class={labelClass}>Phone number</label>
              <input
                id="contact-phone"
                type="tel"
                name="phone"
                placeholder="+1 800 000 0000"
                autocomplete="tel"
                class={inputClass}
              />
              <p class={helpClass}>Your contact number.</p>
            </div>

            <div>
              <label for="contact-message" class={labelClass}>
                Comment or Message <span class="text-teal-600">*</span>
              </label>
              <textarea
                id="contact-message"
                name="message"
                required
                rows="4"
                maxlength="500"
                placeholder="Briefly describe what needs cleaning, and your preferred pickup day."
                class={`${inputClass} resize-none`}></textarea>
            </div>
          </div>

          <div class="mt-7 flex flex-wrap items-center gap-4">
            <button
              type="submit"
              class="inline-flex items-center gap-2.5 rounded-full bg-ink-900 px-7 py-3.5 text-[15px] font-semibold text-white transition-colors hover:bg-ink-800 disabled:cursor-not-allowed disabled:opacity-60"
            >
              <span class="btn-label">Submit</span>
              <svg
                width="16"
                height="16"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2.4"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"></path></svg
              >
            </button>
            <p
              id="form-status"
              role="status"
              aria-live="polite"
              class="hidden text-[14px]"
            >
            </p>
          </div>

          <p class="mt-5 text-[13px] text-ink-500">
            We reply within one working day. Your details are never shared.
          </p>
        </form>
      </div>
    </div>
  </div>
</section>

<script>
  // Copy email / phone to clipboard on click (no label change).
  document.querySelectorAll<HTMLElement>(".copy-pill").forEach((btn) => {
    btn.addEventListener("click", async () => {
      const value = btn.dataset.copy;
      if (!value) return;
      try {
        await navigator.clipboard.writeText(value);
      } catch {
        // fallback for non-secure contexts
        const ta = document.createElement("textarea");
        ta.value = value;
        ta.style.position = "fixed";
        ta.style.opacity = "0";
        document.body.appendChild(ta);
        ta.select();
        document.execCommand("copy");
        ta.remove();
      }
    });
  });

  // Contact form — POST submissions to Web3Forms, which emails them to the
  // address tied to the access key (nihal@peweo.com). Stays on-page with an
  // inline status message instead of a redirect.
  const form = document.getElementById("contact-form") as HTMLFormElement | null;
  const status = document.getElementById("form-status");
  if (form && status) {
    const label = form.querySelector<HTMLElement>(".btn-label");
    const submitBtn = form.querySelector<HTMLButtonElement>('button[type="submit"]');
    const defaultLabel = label?.textContent ?? "Submit";

    const setStatus = (msg: string, ok: boolean) => {
      status.textContent = msg;
      status.classList.remove("hidden");
      status.classList.toggle("text-teal-600", ok);
      status.classList.toggle("text-red-500", !ok);
    };

    form.addEventListener("submit", async (e) => {
      e.preventDefault();
      if (submitBtn) submitBtn.disabled = true;
      if (label) label.textContent = "Sending…";
      status.classList.add("hidden");

      try {
        const res = await fetch(import.meta.env.PUBLIC_WEB3FORMS_ENDPOINT, {
          method: "POST",
          headers: { Accept: "application/json" },
          body: new FormData(form),
        });
        const data = await res.json();
        if (res.ok && data.success) {
          form.reset();
          setStatus("Thanks — your message has been sent.", true);
        } else {
          setStatus(data.message || "Something went wrong. Please try again.", false);
        }
      } catch {
        setStatus("Network error. Please try again.", false);
      } finally {
        if (submitBtn) submitBtn.disabled = false;
        if (label) label.textContent = defaultLabel;
      }
    });
  }
</script>
