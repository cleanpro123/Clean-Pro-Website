---
// FAQ — light cloud gradient, "Questions" brow, accent rule + Exo 2 heading and
// pill-shaped accordions (dark navy when open). Centered single column.
const faqs = [
  { q: "01 How does pickup and delivery work?", a: "Book a collection window online and a Clean Pro driver comes to your door — no bags or containers needed. Once your laundry is cleaned, we deliver it back to you at a time that suits you. Collection and delivery are always free." },
  { q: "02 How long does it take?", a: "Most everyday Wash & Fold orders are back within 24 hours. Dry cleaning and specialist items such as bedding, delicates and shoe care take a little longer — usually 2 to 3 days. You'll see the exact turnaround before you confirm your order." },
  { q: "03 What areas do you cover?", a: "We currently serve 50+ neighborhoods across the city and we're adding more every month. Enter your postcode at checkout to see the pickup slots available near you." },
  { q: "04 How is pricing calculated?", a: "Wash & Fold is priced by weight, from €1.90/kg. Dry cleaning, ironing, bedding and shoe care are priced per item, and you'll always see a clear estimate before you book. No hidden fees, ever." },
  { q: "05 What if I'm not happy with the result?", a: "Your satisfaction is guaranteed. If anything comes back less than perfect, let us know within 48 hours and we'll re-clean it free of charge — or refund you." },
  { q: "06 Do you use eco-friendly products?", a: "Yes. We use plant-based, biodegradable detergents, reusable garment bags and energy-efficient machines, so your clothes get a genuinely fresh clean that's gentle on fabrics and the planet." },
];
---

<section
  id="faq"
  class="relative w-full overflow-hidden"
  style="background:linear-gradient(221deg,#eeeef0 10.38%,#fafafa 76.93%)"
>
  <div class="relative mx-auto w-full max-w-[720px] px-6 py-20 sm:py-24">
    <!-- header -->
    <div class="reveal mb-6">
      <span class="ml-[12px] inline-flex rounded-full bg-cloud-100/50 px-3 py-1.5 text-[12px] font-medium text-ink">
        Questions
      </span>
      <h2
        class="mt-1.5 border-l-[3px] border-accent pl-[12px] font-display text-[clamp(1.6rem,2.1vw,1.9rem)] font-sora tracking-[-0.02em] text-ink"
      >
        Frequently Asked Questions
      </h2>
    </div>

    <!-- accordion -->
    <div class="reveal flex flex-col gap-2.5" id="faq-list">
      {
        faqs.map((f) => (
          <details class="group">
            <summary class="flex cursor-pointer list-none items-center justify-between gap-2 rounded-full bg-cloud-100 px-5 py-3 text-[13px] font-medium text-cloud-900 transition-colors duration-500 ease-[cubic-bezier(0.45,0,0.15,1)] group-[.is-open]:bg-cloud-900 group-[.is-open]:text-white">
              {f.q}
              <span class="grid size-6 shrink-0 place-items-center">
                <svg class="transition-transform duration-500 ease-[cubic-bezier(0.45,0,0.15,1)] group-[.is-open]:-rotate-180" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m6 9 6 6 6-6"/></svg>
              </span>
            </summary>
            <div class="faq-content overflow-hidden">
              <div class="px-5 pb-4 pt-2 text-[12px] leading-relaxed text-cloud-700">
                {f.a}
              </div>
            </div>
          </details>
        ))
      }
    </div>
  </div>
</section>

<script>
  // Accordion — answers slide open/closed smoothly, one open at a time.
  const list = document.getElementById("faq-list");
  if (list) {
    const items = Array.from(list.querySelectorAll<HTMLDetailsElement>("details"));
    const DURATION = 620;
    const EASING = "cubic-bezier(0.45, 0, 0.15, 1)";

    items.forEach((details) => {
      const summary = details.querySelector("summary")!;
      const content = details.querySelector<HTMLElement>(".faq-content")!;
      let anim: Animation | null = null;

      const run = (from: number, to: number, onDone?: () => void) => {
        anim?.cancel();
        content.style.overflow = "hidden";
        content.style.height = from + "px";
        anim = content.animate(
          { height: [from + "px", to + "px"], opacity: [from ? 1 : 0, to ? 1 : 0] },
          { duration: DURATION, easing: EASING }
        );
        anim.onfinish = () => {
          content.style.height = "";
          content.style.overflow = "";
          anim = null;
          onDone?.();
        };
      };

      // keep the visual (navy + rotated icon) in sync from the very first frame
      if (details.open) details.classList.add("is-open");

      const expand = () => {
        details.classList.add("is-open");
        details.open = true;
        run(0, content.offsetHeight);
      };

      const collapse = () => {
        details.classList.remove("is-open");
        run(content.offsetHeight, 0, () => (details.open = false));
      };

      // expose collapse so opening one can close the others
      (details as any)._collapse = () => {
        if (details.open) collapse();
      };

      summary.addEventListener("click", (e) => {
        e.preventDefault();
        if (details.open) {
          collapse();
        } else {
          // one open at a time — close any other open item first
          items.forEach((o) => o !== details && (o as any)._collapse());
          expand();
        }
      });
    });
  }
</script>
