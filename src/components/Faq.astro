---
// FAQ — centred accordion in the shared card language: white cards with a
// hairline ink border, the open one tinted brand.
import SectionHeading from "./SectionHeading.astro";

const faqs = [
  { n: "01", q: "How does pickup and delivery work?", a: "Book a collection window online and a Clean Pro driver comes to your door — no bags or containers needed. Once your laundry is cleaned, we deliver it back to you at a time that suits you. Collection and delivery are always free." },
  { n: "02", q: "How long does it take?", a: "Most everyday Wash & Fold orders are back within 24 hours. Dry cleaning and specialist items such as bedding, delicates and shoe care take a little longer — usually 2 to 3 days. You'll see the exact turnaround before you confirm your order." },
  { n: "03", q: "What areas do you cover?", a: "We currently serve 50+ neighborhoods across the city and we're adding more every month. Enter your postcode at checkout to see the pickup slots available near you." },
  { n: "04", q: "How is pricing calculated?", a: "Wash & Fold is priced by weight, from €1.90/kg. Dry cleaning, ironing, bedding and shoe care are priced per item, and you'll always see a clear estimate before you book. No hidden fees, ever." },
  { n: "05", q: "What if I'm not happy with the result?", a: "Your satisfaction is guaranteed. If anything comes back less than perfect, let us know within 48 hours and we'll re-clean it free of charge — or refund you." },
  { n: "06", q: "Do you use eco-friendly products?", a: "Yes. We use plant-based, biodegradable detergents, reusable garment bags and energy-efficient machines, so your clothes get a genuinely fresh clean that's gentle on fabrics and the planet." },
];
---

<section id="faq" class="bg-white py-20 sm:py-24">
  <div class="container-x">
    <div class="reveal">
      <SectionHeading
        eyebrow="Questions"
        title="Everything you might"
        highlight="want to ask"
        subtitle="Still unsure about something? Send us a message and we'll come back to you the same day."
      />
    </div>

    <div class="reveal mx-auto mt-14 flex max-w-3xl flex-col gap-3" id="faq-list">
      {
        faqs.map((f) => (
          <details class="faq-item group rounded-2xl border border-ink-100 bg-white transition-all duration-300">
            <summary class="flex cursor-pointer list-none items-center justify-between gap-4 px-6 py-5">
              <span class="flex min-w-0 items-baseline gap-4">
                <span class="faq-number font-display text-sm font-extrabold text-ink-300 transition-colors">
                  {f.n}
                </span>
                <span class="font-display text-base font-bold tracking-tight text-ink-900">
                  {f.q}
                </span>
              </span>
              <span class="grid size-8 shrink-0 place-items-center rounded-full border border-ink-100 text-ink-500 transition-colors group-[.is-open]:border-brand-200 group-[.is-open]:bg-brand-500 group-[.is-open]:text-white">
                <svg class="transition-transform duration-500 ease-[cubic-bezier(0.45,0,0.15,1)] group-[.is-open]:-rotate-180" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m6 9 6 6 6-6"/></svg>
              </span>
            </summary>
            <div class="faq-content overflow-hidden">
              <div class="px-6 pb-6 pl-[4.25rem] text-sm leading-relaxed text-ink-500">
                {f.a}
              </div>
            </div>
          </details>
        ))
      }
    </div>
  </div>
</section>

<style>
  .faq-item.is-open {
    border-color: var(--color-brand-200);
    background: linear-gradient(135deg, var(--color-brand-50) 0%, #ffffff 60%);
    box-shadow: 0 24px 50px -34px rgba(30, 33, 36, 0.55);
  }
  .faq-item.is-open .faq-number {
    color: var(--color-brand-500);
  }
</style>

<script>
  // Accordion — answers slide open/closed smoothly, one open at a time.
  const list = document.getElementById("faq-list");
  if (list) {
    const items = Array.from(list.querySelectorAll<HTMLDetailsElement>("details"));
    const DURATION = 620;
    const EASING = "cubic-bezier(0.45, 0, 0.15, 1)";

    items.forEach((details) => {
      const summary = details.querySelector("summary")!;
      const content = details.querySelector<HTMLElement>(".faq-content")!;
      let anim: Animation | null = null;

      const run = (from: number, to: number, onDone?: () => void) => {
        anim?.cancel();
        content.style.overflow = "hidden";
        content.style.height = from + "px";
        anim = content.animate(
          { height: [from + "px", to + "px"], opacity: [from ? 1 : 0, to ? 1 : 0] },
          { duration: DURATION, easing: EASING }
        );
        anim.onfinish = () => {
          content.style.height = "";
          content.style.overflow = "";
          anim = null;
          onDone?.();
        };
      };

      // keep the visual (navy + rotated icon) in sync from the very first frame
      if (details.open) details.classList.add("is-open");

      const expand = () => {
        details.classList.add("is-open");
        details.open = true;
        run(0, content.offsetHeight);
      };

      const collapse = () => {
        details.classList.remove("is-open");
        run(content.offsetHeight, 0, () => (details.open = false));
      };

      // expose collapse so opening one can close the others
      (details as any)._collapse = () => {
        if (details.open) collapse();
      };

      summary.addEventListener("click", (e) => {
        e.preventDefault();
        if (details.open) {
          collapse();
        } else {
          // one open at a time — close any other open item first
          items.forEach((o) => o !== details && (o as any)._collapse());
          expand();
        }
      });
    });
  }
</script>
