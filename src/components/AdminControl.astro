---
// "How it works" — four steps that highlight in turn on a timer, in the shared
// white-card language.
import SectionHeading from "./SectionHeading.astro";

const items = [
  {
    n: "01",
    title: "Schedule a pickup",
    body: "Book online in under a minute. Pick a collection window that fits your day — mornings, evenings or weekends.",
  },
  {
    n: "02",
    title: "We collect your bags",
    body: "A friendly Clean Pro driver arrives at your door, no bags or containers needed — just hand it over.",
  },
  {
    n: "03",
    title: "Expert cleaning & care",
    body: "Your items are sorted, washed, dried and pressed by trained specialists using gentle, eco-friendly products.",
  },
  {
    n: "04",
    title: "Delivered fresh",
    body: "Everything comes back neatly folded or hung — usually within 24 hours, always spotless.",
  },
];
---

<section id="how" class="bg-white py-20 sm:py-24">
  <div class="container-x">
    <div class="reveal">
      <SectionHeading
        eyebrow="Simple by design"
        title="Laundry day, done in"
        highlight="four easy steps"
        subtitle="From the first tap to fresh clothes back in the wardrobe — you only ever open the door."
      />
    </div>

    <div
      id="admin-control"
      class="reveal mt-14 grid gap-5 sm:grid-cols-2 lg:grid-cols-4"
    >
      {
        items.map((it, i) => (
          <button
            type="button"
            class="admin-tab group relative flex h-full flex-col overflow-hidden rounded-3xl border border-ink-100 bg-white p-7 text-left transition-all duration-300 hover:border-brand-200"
            data-index={i}
          >
            <span class="tab-number font-display text-3xl font-extrabold tracking-tight text-ink-200 transition-colors duration-300">
              {it.n}
            </span>
            <h3 class="mt-5 font-display text-lg font-extrabold tracking-tight text-ink-900">
              {it.title}
            </h3>
            <p class="mt-3 text-sm leading-relaxed text-ink-500">{it.body}</p>
            <span class="admin-progress absolute bottom-0 left-0 h-[3px] w-0 bg-brand-500" />
          </button>
        ))
      }
    </div>
  </div>
</section>

<style>
  .admin-tab.is-active {
    border-color: var(--color-brand-200);
    background: linear-gradient(135deg, var(--color-brand-50) 0%, #ffffff 70%);
    box-shadow: 0 24px 50px -34px rgba(30, 33, 36, 0.55);
  }
  .admin-tab.is-active .tab-number {
    color: var(--color-brand-500);
  }
</style>

<script>
  // Auto-playing steps: each is active for 6s, fills a brand progress bar, then
  // advances. Clicking a step jumps to it and restarts the cycle.
  const root = document.getElementById("admin-control");
  if (root) {
    const DURATION = 6000;
    const tabs = Array.from(root.querySelectorAll<HTMLElement>(".admin-tab"));
    let current = -1;
    let timer: ReturnType<typeof setTimeout> | undefined;
    let progress: Animation | null = null;

    const activate = (i: number) => {
      current = i;
      tabs.forEach((t, idx) => {
        t.classList.toggle("is-active", idx === i);
        const bar = t.querySelector<HTMLElement>(".admin-progress");
        if (bar) bar.style.width = "0%";
      });

      const bar = tabs[i].querySelector<HTMLElement>(".admin-progress");
      progress?.cancel();
      if (bar) {
        progress = bar.animate([{ width: "0%" }, { width: "100%" }], {
          duration: DURATION,
          easing: "linear",
          fill: "forwards",
        });
      }

      clearTimeout(timer);
      timer = setTimeout(() => activate((i + 1) % tabs.length), DURATION);
    };

    tabs.forEach((t, i) => t.addEventListener("click", () => activate(i)));

    // pause while the user hovers, resume on leave
    root.addEventListener("mouseenter", () => {
      clearTimeout(timer);
      progress?.pause();
    });
    root.addEventListener("mouseleave", () => {
      progress?.play();
      const remaining = progress
        ? DURATION - (Number(progress.currentTime) || 0)
        : DURATION;
      clearTimeout(timer);
      timer = setTimeout(
        () => activate((current + 1) % tabs.length),
        Math.max(0, remaining),
      );
    });

    activate(0);
  }
</script>
