---
// "The Clean Pro promise" — dark band, same charcoal card language as the
// footer, with a wide eco card in the middle.
import SectionHeading from "./SectionHeading.astro";

const topCards = [
  {
    title: "Free collection & delivery",
    body: "Doorstep pickup and return at no extra cost, seven days a week — including evenings.",
  },
  {
    title: "Live order tracking",
    body: "Follow every order from pickup to delivery, with text updates at each step.",
  },
  {
    title: "Satisfaction guaranteed",
    body: "Not happy with a result? We'll re-clean it free, no questions asked.",
  },
];

const bottomCards = [
  {
    title: "Trusted specialists",
    body: "Trained, background-checked cleaners who treat your clothes like their own.",
  },
  {
    title: "Flexible plans",
    body: "One-off orders or a weekly subscription — pause, skip or cancel anytime.",
  },
  {
    title: "Card-free payment",
    body: "Save your card once and check out in a tap. No cash, no fuss at the door.",
  },
];
---

<section class="bg-white py-20 sm:py-24">
  <div class="container-x">
    <div
      class="rounded-3xl bg-ink-900 px-7 py-12 shadow-[0_28px_70px_-40px_rgba(30,33,36,0.45)] sm:px-12 sm:py-14"
    >
      <div class="reveal">
        <SectionHeading
          eyebrow="The Clean Pro promise"
          title="Cleaner clothes, a whole lot"
          highlight="less hassle"
          subtitle="Every order is insured, tracked and backed by a re-clean guarantee."
          tone="dark"
        />
      </div>

      <!-- row 1 -->
      <div class="reveal mt-12 grid grid-cols-1 gap-5 sm:grid-cols-2 lg:grid-cols-3">
        {
          topCards.map((c) => (
            <article class="flex flex-col rounded-2xl border border-white/15 bg-white/5 p-6 transition-colors duration-300 hover:border-white/30">
              <h3 class="font-display text-base font-bold text-white">
                {c.title}
              </h3>
              <p class="mt-2.5 text-sm leading-relaxed text-white/60">{c.body}</p>
            </article>
          ))
        }
      </div>

      <!-- eco wide card -->
      <div
        class="reveal mt-5 grid grid-cols-1 items-center gap-6 rounded-2xl border border-white/15 bg-white/5 p-6 lg:grid-cols-[1fr_auto]"
      >
        <div>
          <h3 class="font-display text-base font-bold text-white">
            Eco-friendly by default
          </h3>
          <p class="mt-2.5 max-w-xl text-sm leading-relaxed text-white/60">
            We use plant-based, biodegradable detergents, reusable garment bags
            and energy-efficient machines — a genuinely fresh clean that's gentle
            on the planet as well as your fabrics.
          </p>
        </div>
        <div class="flex flex-wrap gap-2">
          {
            ["Plant-based", "Reusable bags", "Low-energy"].map((tag) => (
              <span class="rounded-full border border-white/15 bg-white/5 px-3 py-1.5 text-xs font-semibold text-teal-400">
                {tag}
              </span>
            ))
          }
        </div>
      </div>

      <!-- row 2 -->
      <div class="reveal mt-5 grid grid-cols-1 gap-5 sm:grid-cols-2 lg:grid-cols-3">
        {
          bottomCards.map((c) => (
            <article class="flex flex-col rounded-2xl border border-white/15 bg-white/5 p-6 transition-colors duration-300 hover:border-white/30">
              <h3 class="font-display text-base font-bold text-white">
                {c.title}
              </h3>
              <p class="mt-2.5 text-sm leading-relaxed text-white/60">{c.body}</p>
            </article>
          ))
        }
      </div>
    </div>
  </div>
</section>
