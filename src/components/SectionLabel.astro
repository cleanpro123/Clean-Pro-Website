---
interface Props {
  variant?: "light" | "dark";
  class?: string;
}
const { variant = "light", class: className = "" } = Astro.props;
const styles =
  variant === "dark"
    ? "border-white/15 bg-white/5 text-lav-200"
    : "border-transparent bg-cloud-100/50 text-ink-soft";
---

<span
  class={`inline-flex items-center rounded-full border px-3 py-1.5 text-[13px] font-medium ${styles} ${className}`}
>
  <slot />
</span>
